# Sanity — crea el proyecto en https://sanity.io/manage o con `npx sanity init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-30

# Token de lectura (API > Tokens, permiso "Viewer") — necesario para Draft Mode / Presentation
SANITY_API_READ_TOKEN=

# Token de escritura (API > Tokens, permiso "Editor" o superior) — solo para scripts/seed-experiencias.ts
SANITY_API_WRITE_TOKEN=

# URL pública del sitio desplegado (usada en sitemap, robots.txt y metadata)
NEXT_PUBLIC_SITE_URL=https://xeracion.org

# Clave de la API de Google Calendar (Google Cloud Console > APIs & Services >
# Credentials > Create credentials > API key, restringida a "Calendar API").
# El ID del calendario se configura en src/content/siteSettings.ts
# (googleCalendarId) y debe estar marcado como público.
GOOGLE_CALENDAR_API_KEY=
